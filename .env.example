# Copy to apps/api/.env and apps/mobile/.env as needed.

# API (apps/api/.env)

# PORT=4000

# Local MongoDB:

# MONGODB_URI=mongodb://127.0.0.1:27017/zygo

# MongoDB Atlas (URL-encode special chars in password, e.g. @ -> %40):

# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/zygo?retryWrites=true&w=majority&appName=Zygo

# JWT_SECRET=change-me-in-production

# JWT_EXPIRES_DAYS=7

# CORS_ORIGIN=*



# Mobile (apps/mobile/.env) — use machine LAN IP for physical device

# API_BASE_URL=http://10.0.2.2:4000/api/v1

