# Emulator → PC:
# API_BASE_URL=http://10.0.2.2:4000/api/v1

# Physical phone via USB (after: adb reverse tcp:4000 tcp:4000):
API_BASE_URL=http://127.0.0.1:4000/api/v1

# Physical phone on Wi‑Fi (use your PC's LAN IP):
# API_BASE_URL=http://192.168.x.x:4000/api/v1

# Optional — Google Maps tiles + accurate geocoding/search (see README “Google Maps”):
# Enable: Maps SDK for Android, Geocoding API, Places API
# Restrict key to package com.zygomobile + your debug/release SHA-1
# GOOGLE_MAPS_API_KEY=AIzaSy...
