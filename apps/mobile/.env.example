# Production (Render):
API_BASE_URL=https://zygo.onrender.com/api/v1

# Razorpay public key (same as RAZORPAY_KEY_ID in apps/api/.env — test: rzp_test_…)
RAZORPAY_KEY_ID=

# Mapbox — native maps + address search/geocoding (public token must start with pk.)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
# Optional custom style (default: mapbox/navigation-night-v1)
# MAPBOX_STYLE_ID=mapbox/navigation-night-v1

# API fare/ETA also uses Mapbox Directions when set in apps/api/.env:
# MAPBOX_ACCESS_TOKEN=pk....

# Local emulator:
# API_BASE_URL=http://10.0.2.2:4000/api/v1

# Physical phone via USB (after: adb reverse tcp:4000 tcp:4000):
# API_BASE_URL=http://127.0.0.1:4000/api/v1
