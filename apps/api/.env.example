PORT=4000
# MongoDB Atlas — URL-encode special characters in password (@ → %40)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/zygo?retryWrites=true&w=majority&appName=Zygo
JWT_SECRET=change-me-in-dev
JWT_EXPIRES_DAYS=7
CORS_ORIGIN=*

# Ride driver offer timeout (ms). Dev API defaults to 120000 if unset; production defaults to 15000.
# RIDE_REQUEST_TIMEOUT_MS=120000

# Mapbox Directions for ride ETA/fare (same public token as mobile)
# MAPBOX_ACCESS_TOKEN=pk....

# Email OTP via Brevo (https://app.brevo.com) — if omitted, OTP is printed to the API console in dev
BREVO_API_KEY=
EMAIL_FROM="Zygo <noreply@your-verified-sender.com>"

# Cloudinary (https://cloudinary.com/console) — required for production image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=